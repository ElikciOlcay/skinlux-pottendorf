<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
      <mj-text font-size="14px" color="#111827" />
    </mj-attributes>
    <mj-title>Deine Termin-Anfrage ist eingegangen</mj-title>
  </mj-head>
  <mj-body background-color="#f9fafb">
    <mj-section background-color="#111827" padding="24px 0">
      <mj-column>
        <mj-text align="center" color="#ffffff" font-size="20px" letter-spacing="2px">SKINLUX POTTENDORF</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="24px">
      <mj-column>
        <mj-text font-size="20px" font-weight="500">Deine Termin-Anfrage ist eingegangen</mj-text>
        <mj-text color="#374151">Hallo {DATA_VARIABLE:name},<br/>vielen Dank für deine Anfrage. Wir melden uns zur Bestätigung deines Termins.</mj-text>

        <mj-wrapper padding="0">
          <mj-section background-color="#f9fafb" padding="16px" border="1px solid #e5e7eb">
            <mj-column>
              <mj-table font-size="14px" color="#111827">
                <tr><td style="color:#6b7280;font-weight:600;padding:6px 0;width:40%">E-Mail</td><td style="padding:6px 0">{DATA_VARIABLE:email}</td></tr>
                <tr><td style="color:#6b7280;font-weight:600;padding:6px 0">Telefon</td><td style="padding:6px 0">{DATA_VARIABLE:phone}</td></tr>
                <tr><td style="color:#6b7280;font-weight:600;padding:6px 0">Geschlecht</td><td style="padding:6px 0">{DATA_VARIABLE:gender}</td></tr>
                <tr><td style="color:#6b7280;font-weight:600;padding:6px 0">Auswahl</td><td style="padding:6px 0">{DATA_VARIABLE:zone}</td></tr>
                <tr><td style="color:#6b7280;font-weight:600;padding:6px 0">Preis</td><td style="padding:6px 0"><span style="text-decoration:line-through;color:#9ca3af;margin-right:8px">{DATA_VARIABLE:originalPriceEuro}</span> <span style="color:#16a34a;font-weight:700">{DATA_VARIABLE:discountedPriceEuro}</span></td></tr>
                <tr><td style="color:#6b7280;font-weight:600;padding:6px 0">Wunschtermin</td><td style="padding:6px 0">{DATA_VARIABLE:preferredDate} {DATA_VARIABLE:preferredTime}</td></tr>
              </mj-table>
            </mj-column>
          </mj-section>
        </mj-wrapper>

        <mj-section background-color="#ffffff" padding="16px">
          <mj-column>
            <mj-text color="#6b7280" font-weight="600" padding-bottom="6px">Nachricht</mj-text>
            <mj-text white-space="pre-wrap">{DATA_VARIABLE:message}</mj-text>
          </mj-column>
        </mj-section>

      </mj-column>
    </mj-section>

    <mj-section background-color="#f9fafb" padding="0 24px 16px 24px">
      <mj-column>
        <mj-wrapper padding="0">
          <mj-section background-color="#111827" padding="14px" border-radius="12px">
            <mj-column width="70%">
              <mj-text color="#9ca3af" font-size="10px" letter-spacing="1.5px" text-transform="uppercase" padding-bottom="4px">Aktuelle Neuigkeit</mj-text>
              <mj-text color="#ffffff" font-size="16px" font-weight="600" padding-bottom="4px">SkinPen Precision</mj-text>
              <mj-text color="#d1d5db" font-size="13px" line-height="19px" padding-bottom="0">
                Präzises Microneedling für Narben, Poren und ein sichtbar glatteres Hautbild.
              </mj-text>
            </mj-column>
            <mj-column width="30%" vertical-align="middle">
              <mj-button
                href="https://pottendorf.skinlux.at/behandlungen/skinpen-precision"
                background-color="#ffffff"
                color="#111827"
                font-size="11px"
                font-weight="600"
                inner-padding="10px 12px"
                border-radius="8px"
              >
                Mehr erfahren
              </mj-button>
            </mj-column>
          </mj-section>
        </mj-wrapper>
      </mj-column>
    </mj-section>

    <mj-section background-color="#f9fafb" padding="16px">
      <mj-column>
        <mj-text align="center" color="#6b7280" font-size="12px">Skinlux Pottendorf • Marktplatz 14, 2486 Pottendorf • hey@skinlux.at • 0664 91 88 632</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>


