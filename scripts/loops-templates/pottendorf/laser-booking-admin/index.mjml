<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
      <mj-text font-size="14px" color="#111827" />
    </mj-attributes>
    <mj-title>Neue Termin-Anfrage (Laser-Aktion)</mj-title>
  </mj-head>
  <mj-body background-color="#f9fafb">
    <mj-section background-color="#111827" padding="24px 0">
      <mj-column>
        <mj-text align="center" color="#ffffff" font-size="20px" letter-spacing="2px">SKINLUX POTTENDORF</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="24px">
      <mj-column>
        <mj-text font-size="20px" font-weight="500">Neue Termin-Anfrage (Laser-Aktion)</mj-text>
        <mj-text color="#374151">Es ist eine neue Termin-Anfrage eingegangen.</mj-text>

        <mj-wrapper padding="0">
          <mj-section background-color="#f9fafb" padding="16px" border="1px solid #e5e7eb">
            <mj-column>
              <mj-table font-size="14px" color="#111827">
                <tr><td style="color:#6b7280;font-weight:600;padding:6px 0;width:40%">Name</td><td style="padding:6px 0">{{data.name}}</td></tr>
                <tr><td style="color:#6b7280;font-weight:600;padding:6px 0">E-Mail</td><td style="padding:6px 0">{{data.email}}</td></tr>
                <tr><td style="color:#6b7280;font-weight:600;padding:6px 0">Telefon</td><td style="padding:6px 0">{{data.phone}}</td></tr>
                <tr><td style="color:#6b7280;font-weight:600;padding:6px 0">Geschlecht</td><td style="padding:6px 0">{{data.gender}}</td></tr>
                <tr><td style="color:#6b7280;font-weight:600;padding:6px 0">Zone</td><td style="padding:6px 0">{{data.zone}}</td></tr>
                <tr><td style="color:#6b7280;font-weight:600;padding:6px 0">Preis</td><td style="padding:6px 0"><span style="text-decoration:line-through;color:#9ca3af;margin-right:8px">{{data.originalPriceEuro}}</span><span style="color:#16a34a;font-weight:700">{{data.discountedPriceEuro}}</span></td></tr>
                <tr><td style="color:#6b7280;font-weight:600;padding:6px 0">Wunschtermin</td><td style="padding:6px 0">{{data.preferredDate}} {{data.preferredTime}}</td></tr>
              </mj-table>
            </mj-column>
          </mj-section>
        </mj-wrapper>

        <mj-raw>{{#if data.message}}</mj-raw>
        <mj-section background-color="#ffffff" padding="16px">
          <mj-column>
            <mj-text color="#6b7280" font-weight="600" padding-bottom="6px">Nachricht</mj-text>
            <mj-text white-space="pre-wrap">{{data.message}}</mj-text>
          </mj-column>
        </mj-section>
        <mj-raw>{{/if}}</mj-raw>

        <mj-text color="#6b7280" font-size="12px">50%-Aktion gilt für die ersten zwei Behandlungen.</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#f9fafb" padding="16px">
      <mj-column>
        <mj-text align="center" color="#6b7280" font-size="12px">Skinlux Pottendorf • Marktplatz 14, 2486 Pottendorf • hey@skinlux.at • 0664 91 88 632</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
